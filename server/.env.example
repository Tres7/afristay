# =========================
# Django
# =========================
DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
# Délai (s) pendant lequel un refresh token renouvelé renvoie encore la même paire (renouvellements parallèles de NextAuth)
JWT_REFRESH_GRACE_SECONDS=60

# =========================
# PostgreSQL
# =========================
POSTGRES_DB=afristay
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# =========================
# pgAdmin
# =========================
PGADMIN_DEFAULT_EMAIL=your_email@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# =========================
# RabbitMQ
# =========================
RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# =========================
# Email
# =========================
# Brevo (offre gratuite : 300 emails/jour). Brevo → SMTP & API → onglet SMTP : identifiant et clé SMTP.
# Domaine kwa-ba.com authentifié dans Brevo (DKIM brevo1/brevo2, DMARC) ; en local sans envoi réel :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Kwa-Ba <noreply@kwa-ba.com>
SERVER_EMAIL=noreply@kwa-ba.com
EMAIL_TIMEOUT=20

# =========================
# Paiement en ligne (FedaPay)
# =========================
# Sans clé secrète : paiement désactivé, réservations confirmées sans encaissement.
# Clés : tableau de bord FedaPay → Paramètres → Clés API (sk_sandbox_… en test, sk_live_… en production)
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
# Tableau de bord FedaPay → Webhooks → clé secrète du webhook
FEDAPAY_WEBHOOK_SECRET=
PAIEMENT_EXPIRATION_MINUTES=30

# PayPal (paiement en euros) : developer.paypal.com → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Worker des paiements : pause entre deux emails (Mailtrap gratuit limite le débit) et URL publique de l'API
PAIEMENTS_PAUSE_EMAIL=0
BACKEND_URL=http://localhost:8000

# Contact d'assistance donné aux voyageurs (transferts aéroport) et adresse de réponse des emails
ASSISTANCE_CONTACT=info@kwa-ba.com
EMAIL_REPLY_TO=info@kwa-ba.com

# AI Concierge (Gemini) : clé sur aistudio.google.com → Get API key, projet avec facturation activée
# (en offre gratuite, Google peut utiliser les conversations pour améliorer ses produits). Vide = désactivé.
GEMINI_API_KEY=
CONCIERGE_MODELE=gemini-3.8-flash
CONCIERGE_REFLEXION=low
CONCIERGE_RECHERCHE_WEB=True
CONCIERGE_MAX_PAR_HEURE=20
CONCIERGE_MAX_PAR_JOUR=60
