# Copy to nginx.env on the VPS (chmod 600). Never commit it.
# Public address of the photos bucket (Cloudflare R2 > bucket > Settings > Public access > r2.dev URL),
# without a trailing slash. nginx serves it under https://kwa-ba.com/photos/ with a local cache.
R2_PUBLIC_ORIGIN=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
