# Copy to backup.env on the VPS (chmod 600). Off-site copy of the database backups (a dedicated R2 bucket,
# separate from the photos one, with a key limited to that bucket). Empty: local backups only.
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT_URL=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14
