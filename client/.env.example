# Auth.js
AUTH_SECRET=ta_cle_longue_aleatoire
# URL publique du site (en production derrière nginx : https://<domaine>), utilisée pour les URL d'Auth.js
AUTH_URL=http://localhost:3000

# APi
INTERNAL_API_URL=http://backend:8000/api
# NEXT_PUBLIC_* : figées dans le code du navigateur au build de l'image de production
# (variables de dépôt GitHub PUBLIC_SITE_URL, PUBLIC_GOOGLE_CLIENT_ID, PUBLIC_CONTACT_EMAIL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api


NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Adresse publique du site (aperçus de lien WhatsApp / Facebook, liens absolus)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
